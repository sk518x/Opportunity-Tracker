# Opportunity Tracker - Environment Variables
#
# Copy this file to .env for your own reference when setting up the project.
# Replace every placeholder with your own values.
# Never commit a completed .env file.

# ------------------------------------------------------------
# n8n / Render
# ------------------------------------------------------------

N8N_HOST=your-service-name.onrender.com
N8N_PROTOCOL=https
N8N_PORT=10000

N8N_ENCRYPTION_KEY=generate_a_long_random_string
GENERIC_TIMEZONE=Africa/Johannesburg

# ------------------------------------------------------------
# PostgreSQL (Neon)
# ------------------------------------------------------------

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-project.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=your_database_name
DB_POSTGRESDB_USER=your_database_username
DB_POSTGRESDB_PASSWORD=your_database_password

DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------

TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ------------------------------------------------------------
# Groq
# ------------------------------------------------------------

GROQ_API_KEY=your_groq_api_key

# ------------------------------------------------------------
# Google Sheets (OAuth)
# ------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-service-name.onrender.com/rest/oauth2-credential/callback

GOOGLE_SPREADSHEET_ID=your_google_sheet_id
