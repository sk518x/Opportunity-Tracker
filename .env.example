Opportunity Tracker - Environment Variables Reference
#
# This project runs on n8n (self-hosted on Render), so most of these values
# are entered as Render environment variables or n8n credentials - not a
# traditional .env file loaded by a single app. This file documents every
# value the system needs, so a new setup can be reproduced end to end.
#
# Copy this file to `.env` for your own reference while setting up, or use
# it as a checklist when configuring Render's Environment tab and n8n's
# Credentials panel. Never commit a filled-in version of this file.

# ── n8n / Render service config ─────────────────────────────
N8N_PORT=10000
N8N_PROTOCOL=https
N8N_HOST=your-service-name.onrender.com
WEBHOOK_URL=https://your-service-name.onrender.com/
N8N_ENCRYPTION_KEY=generate_a_long_random_string_and_keep_it_safe
GENERIC_TIMEZONE=Africa/Johannesburg

# ── PostgreSQL (Neon) ────────────────────────────────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-project.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=your_database_name
DB_POSTGRESDB_USER=your_neon_username
DB_POSTGRESDB_PASSWORD=your_neon_password
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
DB_POSTGRESDB_POOL_SIZE=2

# ── Telegram Bot (create via @BotFather) ────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Groq (AI extraction - text + vision) ────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Models in use. Groq retires models regularly (the original Llama and Qwen 3.6
# models were both shut down in 2026), so check console.groq.com/docs/deprecations:
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── Google Sheets API (OAuth, set up via Google Cloud Console) ──
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=https://your-service-name.onrender.com/rest/oauth2-credential/callback
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ── Memory tuning (Render free tier = 512MB) ────────────────
NODE_OPTIONS=--max-old-space-size=460
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
